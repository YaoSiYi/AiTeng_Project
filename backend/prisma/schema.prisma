generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== 商品相关 ====================

model Goods {
  id           Int      @id @default(autoincrement())
  goodsName    String   @map("goods_name") @db.VarChar(200)
  categoryId   Int      @map("category_id")
  goodsSn      String   @map("goods_sn") @db.VarChar(60)
  brandId      Int      @map("brand_id") @default(0)
  storeCount   Int      @map("store_count") @default(0)
  commentCount Int      @map("comment_count") @default(0)
  salesSum     Int      @map("sales_sum") @default(0)
  goodsContent String?  @map("goods_content") @db.LongText
  goodsImg     String?  @map("goods_img") @db.VarChar(255)
  originalImg  String?  @map("original_img") @db.VarChar(255)
  isOnSale     Int      @map("is_on_sale") @default(1)
  isDelete     Int      @map("is_delete") @default(0)
  isBest       Int      @map("is_best") @default(0)
  isNew        Int      @map("is_new") @default(0)
  isHot        Int      @map("is_hot") @default(0)
  shopPrice    Decimal  @map("shop_price") @db.Decimal(10, 2)
  marketPrice  Decimal  @map("market_price") @db.Decimal(10, 2)
  costPrice    Decimal  @map("cost_price") @db.Decimal(10, 2)
  keywords     String?  @map("keywords") @db.VarChar(255)
  goodsRemark  String?  @map("goods_remark") @db.VarChar(255)
  sortOrder    Int      @map("sort_order") @default(50)
  createTime   DateTime @default(now()) @map("create_time")
  updateTime   DateTime @updatedAt @map("update_time")

  @@map("tp_goods")
}

model GoodsCategory {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  parentId   Int      @map("parent_id") @default(0)
  sortOrder  Int      @map("sort_order") @default(50)
  isShow     Int      @map("is_show") @default(1)
  image      String?  @db.VarChar(255)
  createTime DateTime @default(now()) @map("create_time")
  updateTime DateTime @updatedAt @map("update_time")

  @@map("tp_goods_category")
}

model GoodsImages {
  id       Int    @id @default(autoincrement())
  goodsId  Int    @map("goods_id")
  imageUrl String @map("image_url") @db.VarChar(255)
  sortOrder Int   @map("sort_order") @default(0)

  @@map("tp_goods_images")
}

model Brand {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  logo       String?  @db.VarChar(255)
  sortOrder  Int      @map("sort_order") @default(50)
  isShow     Int      @map("is_show") @default(1)
  createTime DateTime @default(now()) @map("create_time")
  updateTime DateTime @updatedAt @map("update_time")

  @@map("tp_brand")
}

// ==================== 订单相关 ====================

model Order {
  id             Int      @id @default(autoincrement())
  orderNo        String   @unique @map("order_no") @db.VarChar(50)
  userId         Int      @map("user_id")
  consignee      String   @db.VarChar(60)
  province       Int      @default(0)
  city           Int      @default(0)
  district       Int      @default(0)
  address        String?  @db.VarChar(255)
  zipcode        String?  @db.VarChar(20)
  tel            String?  @db.VarChar(20)
  mobile         String?  @db.VarChar(20)
  email          String?  @db.VarChar(100)
  goodsPrice     Decimal  @map("goods_price") @db.Decimal(10, 2)
  shippingPrice  Decimal  @map("shipping_price") @db.Decimal(10, 2) @default(0)
  orderAmount    Decimal  @map("order_amount") @db.Decimal(10, 2)
  totalAmount    Decimal  @map("total_amount") @db.Decimal(10, 2)
  orderStatus    Int      @map("order_status") @default(0)
  payStatus      Int      @map("pay_status") @default(0)
  shippingStatus Int      @map("shipping_status") @default(0)
  payTime        DateTime? @map("pay_time")
  shippingTime   DateTime? @map("shipping_time")
  confirmTime    DateTime? @map("confirm_time")
  payName        String?  @map("pay_name") @db.VarChar(100)
  shippingName   String?  @map("shipping_name") @db.VarChar(100)
  invoiceNo      String?  @map("invoice_no") @db.VarChar(50)
  remark         String?  @db.VarChar(255)
  expressNo      String?  @map("express_no") @db.VarChar(50)
  expressCode    String?  @map("express_code") @db.VarChar(50)
  createTime     DateTime @default(now()) @map("create_time")
  updateTime     DateTime @updatedAt @map("update_time")

  @@map("tp_order")
}

model OrderGoods {
  id          Int     @id @default(autoincrement())
  orderId     Int     @map("order_id")
  goodsId     Int     @map("goods_id")
  goodsName   String  @map("goods_name") @db.VarChar(200)
  goodsSn     String  @map("goods_sn") @db.VarChar(60)
  goodsNum    Int     @map("goods_num") @default(1)
  marketPrice Decimal @map("market_price") @db.Decimal(10, 2)
  goodsPrice  Decimal @map("goods_price") @db.Decimal(10, 2)
  goodsAttr   String? @map("goods_attr") @db.VarChar(500)

  @@map("tp_order_goods")
}

model OrderAction {
  id             Int      @id @default(autoincrement())
  orderId        Int      @map("order_id")
  actionUser     String   @map("action_user") @db.VarChar(50)
  actionNote     String?  @map("action_note") @db.VarChar(255)
  orderStatus    Int      @map("order_status") @default(0)
  payStatus      Int      @map("pay_status") @default(0)
  shippingStatus Int      @map("shipping_status") @default(0)
  actionTime     DateTime @default(now()) @map("action_time")

  @@map("tp_order_action")
}

// ==================== 用户相关 ====================

model Users {
  id          Int       @id @default(autoincrement())
  nickname    String    @db.VarChar(100)
  password    String    @db.VarChar(255)
  paypwd      String?   @db.VarChar(255)
  email       String?   @db.VarChar(100)
  mobile      String?   @db.VarChar(20)
  avatar      String?   @db.VarChar(255)
  sex         Int       @default(0)
  birthday    DateTime?
  money       Decimal   @default(0) @db.Decimal(10, 2)
  frozenMoney Decimal   @default(0) @map("frozen_money") @db.Decimal(10, 2)
  rankPoints  Int       @default(0) @map("rank_points")
  payPoints   Int       @default(0) @map("pay_points")
  regTime     DateTime  @default(now()) @map("reg_time")
  lastLogin   DateTime? @map("last_login")
  lastIp      String?   @map("last_ip") @db.VarChar(50)
  userLevelId Int       @default(1) @map("user_level_id")
  isDelete    Int       @default(0) @map("is_delete")
  createTime  DateTime  @default(now()) @map("create_time")
  updateTime  DateTime  @updatedAt @map("update_time")

  @@map("tp_users")
}

model UserAddress {
  id        Int     @id @default(autoincrement())
  userId    Int     @map("user_id")
  consignee String  @db.VarChar(60)
  province  Int     @default(0)
  city      Int     @default(0)
  district  Int     @default(0)
  address   String  @db.VarChar(255)
  zipcode   String? @db.VarChar(20)
  tel       String? @db.VarChar(20)
  mobile    String  @db.VarChar(20)
  isDefault Int     @default(0) @map("is_default")

  @@map("tp_user_address")
}

model UserLevel {
  id          Int     @id @default(autoincrement())
  levelName   String  @map("level_name") @db.VarChar(50)
  minPoints   Int     @map("min_points") @default(0)
  maxPoints   Int     @map("max_points") @default(0)
  discount    Decimal @default(1) @db.Decimal(3, 2)
  description String? @db.VarChar(255)

  @@map("tp_user_level")
}

// ==================== 系统配置 ====================

model Config {
  id     Int    @id @default(autoincrement())
  name   String @db.VarChar(100)
  value  String @db.Text
  remark String? @db.VarChar(255)

  @@map("tp_config")
}

model Plugin {
  id          Int    @id @default(autoincrement())
  code        String @unique @db.VarChar(50)
  name        String @db.VarChar(100)
  version     String @db.VarChar(20)
  author      String? @db.VarChar(100)
  description String? @db.VarChar(255)
  config      String? @db.Text
  status      Int    @default(1)

  @@map("tp_plugin")
}

model Admin {
  id        Int       @id @default(autoincrement())
  username  String    @unique @db.VarChar(50)
  password  String    @db.VarChar(255)
  nickname  String?   @db.VarChar(100)
  email     String?   @db.VarChar(100)
  mobile    String?   @db.VarChar(20)
  avatar    String?   @db.VarChar(255)
  roleId    Int       @map("role_id") @default(0)
  lastLogin DateTime? @map("last_login")
  lastIp    String?   @map("last_ip") @db.VarChar(50)
  status    Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("tp_admin")
}

model AdminRole {
  id          Int    @id @default(autoincrement())
  roleName    String @map("role_name") @db.VarChar(50)
  permissions String? @db.Text
  description String? @db.VarChar(255)

  @@map("tp_admin_role")
}
