# 应用配置
APP_PORT=4000
APP_ENV=development

# 数据库配置
DATABASE_URL="mysql://root:password@localhost:3306/tpshop"

# Redis配置
REDIS_URL="redis://localhost:6379"

# JWT配置
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# 日志配置
LOG_LEVEL="info"
LOG_DIR="logs"

# 上传配置
UPLOAD_DIR="uploads"
MAX_FILE_SIZE=10485760
